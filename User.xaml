<Page x:Class="WpfApp1kursak.User"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1kursak"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="User">

    <Grid Background="LightGray" ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" ></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="id" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center"/>
        <Grid Grid.Column="0" Grid.Row="1" ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" VerticalAlignment="Center">Мої дані:</TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center">Телефон:</TextBlock>
            <TextBox x:Name="telBox" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center">Пароль:</TextBlock>
            <TextBox x:Name="parBox" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Grid.Row="3" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center">Посада:</TextBlock>
            <TextBlock x:Name="posadaBox" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Grid.Row="4" Grid.Column="0" TextAlignment="Center" VerticalAlignment="Center">Рівень доступу:</TextBlock>
            <TextBlock x:Name="rivDostBox" Grid.Row="4" Grid.Column="1"/>
            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Зберегти зміни" Margin="80,7" BorderBrush="DarkBlue" Click="SaveChanges_Click"/>
        </Grid>
        <Grid x:Name="middleColumn" Grid.Column="1" Grid.Row="1" ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" TextAlignment="Center" VerticalAlignment="Center">Список опитувань:</TextBlock>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Visible">
                <ListBox x:Name="OpitList" PreviewMouseWheel="UserList_PreviewMouseWheel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock FontWeight="Bold" Text="{Binding Tema}"/>
                                <TextBlock FontSize="12">
                                    <Run Text=" Питань: "/>
                                    <TextBlock Text="{Binding KstPitann, Mode=OneWay}" />
                                    <Run Text=" Тр-сть: "/>
                                    <Run Text="{Binding TrivOp, Mode=OneWay}"/>     
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            <Button x:Name="startOp" Grid.Row="2" Content="Розпочати опитування!" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="DarkBlue" Click="goToOpituvClick"/>
        </Grid>
        <Grid Grid.Column="2" Grid.Row="1" ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" TextAlignment="Center" VerticalAlignment="Center">Проходження опитування:</TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Тема:</TextBlock>
            <TextBlock x:Name="temaOp" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Залишилось часу:</TextBlock>
            <TextBlock x:Name="zalChas" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock x:Name="nomPit" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
            <DockPanel Grid.Column="1" Grid.Row="3">
                <!-- Лівий текст -->
                <TextBlock x:Name="pit" DockPanel.Dock="Left" Width="110" VerticalAlignment="Center"/>
                <!-- Права панель зі стрілками -->
                <Grid DockPanel.Dock="Right" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Content="˄" Grid.Row="0" Click="PrevQuestion_Click"/>
                    <Button Content="˅" Grid.Row="1" Click="NextQuestion_Click"/>
                </Grid>
            </DockPanel>

            <!--<TextBlock x:Name="nomPit" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="⬆️" Click="PrevQuestion_Click" Margin="5" Width="50"/>
                <Button Content="⬇️" Click="NextQuestion_Click" Margin="5" Width="50"/>
            </StackPanel>-->

            <!--<TextBlock x:Name="pit" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"/>-->
            <TextBlock x:Name="vidpNaPit" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
            <Button x:Name="yes" Grid.Row="5" Grid.Column="0" Content="Так" Margin="33,7" BorderBrush="DarkBlue" Click="yes_Click"/>
            <Button x:Name="no" Grid.Row="5" Grid.Column="1" Content="Ні" Margin="33,7" BorderBrush="DarkBlue" Click="no_Click"/>
            <Button x:Name="endGol" Grid.Row="6" Grid.Column="0" Margin="53,7" Grid.ColumnSpan="2" BorderBrush="DarkBlue" Click="endGol_Click">Завершити голосування</Button>
        </Grid>
    </Grid>
</Page>
