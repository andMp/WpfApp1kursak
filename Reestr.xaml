<Page x:Class="WpfApp1kursak.Reestr"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#B7BFCF" Height="300" Width="700">
        <Border MinWidth="300" MinHeight="230" Margin="15" Background="#87CEEB" VerticalAlignment="Center" Padding="25" MaxWidth="650" CornerRadius="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Coral"  ShadowDepth="0"></DropShadowEffect>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Реєстрація!" FontSize="30" FontWeight="Bold" Margin="0 0 0 20"/>
                <Grid ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Введіть телефон:" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Введіть пароль" HorizontalAlignment="Left"/>
                    <TextBox x:Name="telBox" Grid.Column="1" Grid.Row="0"/>
                    <PasswordBox x:Name="parBox" Grid.Column="1" Grid.Row="1"/>
                </Grid>

                <Button Width="200" Content="Зареєструватися" Click="ZarButtonClick"/>
                <Button Width="200" Content="На головну" Click="NaGolClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
